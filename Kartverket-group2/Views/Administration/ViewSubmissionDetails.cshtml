@model Kartverket_group2.Models.Submission
@{
    ViewData["Title"] = "Submission Details";
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <style>
    /* Base styles */
    .shapes-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .shapeData {
        transition: background-color 0.2s;
    }

    .shapeData:hover {
        background-color: rgba(0, 0, 0, 0.05);
        cursor: pointer;
    }

    /* Buttons */
    .btn-success {
            background-color: #28A745 !important;
        border-color: #1e7e34 !important;
    }

    .btn-danger {
        background-color: #c82333 !important;
        border-color: #bd2130 !important;
    }

    /* Toast notification */
    .status-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 1rem;
        border-radius: 0.5rem;
        color: white;
        z-index: 10000;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .success-notification {
        background-color: #198754;
    }

    .info-notification {
        background-color: #0d6efd;
    }

    .card-body #map {
        /* Adjust the subtraction value based on your footer height */
        height: calc(500px - 60px);
        min-height: 400px; /* Ensures map doesn't get too small */
    }

    /* Adjust spacing between map and admin card */
    .card.shadow-sm.mb-4 {
        margin-bottom: 1rem !important; /* Reduced from 1.5rem */
    }

    /* Map popup styles */
    .wrapped-popup {
        max-width: 300px;
    }

    /* Update button hover state */
    .btn-success:hover {
        background-color: #218838 !important; /* Darker shade of green */
    }

    /* Modal confirm buttons hover states */
    .modal-footer .btn-primary {
        background-color: #28A745 !important;
        border-color: #28A745 !important;
    }

    .modal-footer .btn-primary:hover {
        background-color: #218838 !important;
        border-color: #218838 !important;
    }

    .modal-footer .btn-secondary:hover {
        background-color: #5a6268 !important;
        border-color: #545b62 !important;
    }

    .btn-danger:hover {
        background-color: #9e1b28 !important;
        border-color: #bd2130 !important;
    }




    /* Shape type badge colors */
    .badge.shape-type-circle {
        background-color: #F44336;
    }

    .badge.shape-type-polygon {
        background-color: #2196F3;
    }

    .badge.shape-type-marker,
    .badge.shape-type-point {
        background-color: #4CAF50;
    }

    .badge.shape-type-polyline,
    .badge.shape-type-linestring {
        background-color: #FFC107;
    }

    .status-card {
        padding-bottom: 20px;
    }

    /* Responsive adjustments */
    @@media (max-width: 991.98px) {
        .container-fluid {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        #map {
            height: 400px;
        }

            .status-card {
            padding-bottom: 40px;
        }
    }
</style>
</head>
<body>
    <div class="container-fluid px-4 py-3">
        <div class="d-flex align-items-center mb-4">
            <a href="@Url.Action("Admin")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Tilbake til Admin
            </a>
            <h4 class="mb-0 ms-3">Innmelding ID: @Model.Id</h4>
        </div>

        <div class="row g-4">
            <!-- Details and Shapes List Column -->
            <div class="col-12 col-lg-6">
                <!-- Details Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">Innmelding Detaljer</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">BrukerID:</dt>
                            <dd class="col-sm-8">@Model.UserId</dd>

                            <dt class="col-sm-4">Tittel:</dt>
                            <dd class="col-sm-8">@Model.Comment</dd>

                            <dt class="col-sm-4">Kommunenummer:</dt>
                            <dd class="col-sm-8">@Model.Municipalitynr</dd>

                            <dt class="col-sm-4">Tidsstempel:</dt>
                            <dd class="col-sm-8">@Model.Timestamp</dd>

                            <dt class="col-sm-4">Kartgrunnlag:</dt>
                            <dd class="col-sm-8">@Model.GeoJsonData.ActiveTileLayer</dd>
                        </dl>
                    </div>
                </div>

                <!-- Shapes List Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Figurer</h5>
                        <span class="badge bg-secondary">@Model.GeoJsonData.Features.Count() totalt</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="shapes-list">
                            <ul class="list-group list-group-flush">
                                @foreach (var feature in Model.GeoJsonData.Features)
                                {
                                    <li class="list-group-item shapeData" data-feature-id="@feature.Properties.Id">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge shape-type-@(feature.Properties.Type.ToLower())">@feature.Properties.Type</span>
                                            <small class="text-muted">ID: @feature.Properties.Id</small>
                                        </div>
                                        <div class="mb-2">
                                            <strong>Kommentar:</strong> @feature.Properties.Comment
                                        </div>
                                        <div class="small text-muted">
                                            <div>Lagt til: @feature.Properties.AddedAt</div>
                                            <div>Sist endret: @feature.Properties.LastEdited</div>
                                        </div>
                                        <div class="small text-muted mt-2">
                                            @if (feature.Properties.Type == "circle" && feature.Properties.Radius.HasValue)
                                            {
                                                <div>Koordinater: @($"{feature.Geometry.Coordinates}, {{radius: {feature.Properties.Radius}}}")</div>
                                            }
                                            else
                                            {
                                                <div>Koordinater: @feature.Geometry.Coordinates</div>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Map and Controls Column -->
            <div class="col-12 col-lg-6 status-card">
                <!-- Map Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">Kart</h5>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="width: 100%;"></div>
                    </div>
                </div>

                <!-- Status Controls Card -->
                <div class="card shadow-sm status-card ">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">Administrasjon</h5>
                    </div>
                    <div class="card-body">
                        <!-- Status Update Form -->
                        <form asp-action="UpdateStatus" asp-controller="Administration" method="post" id="updateStatusForm" class="mb-3">
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label for="status" class="form-label">Status:</label>
                                <select name="status" id="status" class="form-select">
                                    @foreach (var status in new[] { "Ikke påbegynt", "Under behandling", "Behandlet", "Ikke tatt til følge" })
                                    {
                                        <option value="@status" selected="@(Model.Status == status)">@status</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="adminComment" class="form-label">Kommentar til innsender:</label>
                                <textarea name="adminComment" id="comment" class="form-control">@Model.AdminComment</textarea> <!-- Display the comment -->
                            </div>

                            <div class="form-check mb-3">
                                <input type="checkbox" id="skipEmail" name="skipEmail" class="form-check-input" value="true" />
                                <label type for="skipEmail" class="form-check-label">Ikke send epost for oppdatering</label>
                            </div>

                            <button type="button" onclick="handleStatusUpdate()" class="btn btn-success w-100 mb-2">
                                <i class="bi bi-save"></i> Oppdater Status
                            </button>
                        </form>

                        <form id="deleteForm" asp-action="DeleteSubmission" asp-controller="Administration" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()
                            <button type="button" onclick="showConfirmDialog()" class="btn btn-danger w-100">
                                <i class="bi bi-trash"></i> Slett innmelding
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <!-- Status Notification -->
        <div id="statusNotification" class="status-notification" style="display: none;">
            <span id="notificationMessage"></span>
        </div>
    <div>
        <!-- Modals -->
        <div class="modal fade" id="confirmDialog" tabindex="-1" aria-hidden="true" style="display: none;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Bekreft sletting</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Er du sikker på at du vil slette denne innsendingen?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Nei</button>
                        <button type="button" class="btn btn-danger" onclick="confirmDelete()">Ja</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="emailConfirmDialog" tabindex="-1" aria-hidden="true" style="display: none;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Bekreft E-post</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Vil du sende en e-post om denne statusendringen?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="confirmStatusUpdate(false)">Nei</button>
                        <button type="button" class="btn btn-primary" onclick="confirmStatusUpdate(true)">Ja</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Map initialization
        var map = L.map('map');

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var geoJsonData = @Html.Raw(Json.Serialize(Model.GeoJsonData));
        var featureGroup = L.featureGroup().addTo(map);
        var bounds = L.latLngBounds();
        var featureLayers = {};



        geoJsonData.features.forEach(function (feature) {
            var layer;
            switch (feature.properties.type.toLowerCase()) {
                case 'circle':
                    if (feature.geometry.type === "Point" && feature.properties.radius) {
                        var latlng = L.latLng(feature.geometry.coordinates[1], feature.geometry.coordinates[0]);
                        layer = L.circle(latlng, { radius: feature.properties.radius });
                        var radiusInDegrees = feature.properties.radius / 111300;
                        bounds.extend([latlng.lat - radiusInDegrees, latlng.lng - radiusInDegrees]);
                        bounds.extend([latlng.lat + radiusInDegrees, latlng.lng + radiusInDegrees]);
                    }
                    break;
                case 'marker':
                case 'point':
                    layer = L.marker(L.latLng(feature.geometry.coordinates[1], feature.geometry.coordinates[0]));
                    bounds.extend(layer.getLatLng());
                    break;
                case 'polygon':
                    layer = L.polygon(feature.geometry.coordinates[0].map(coord => [coord[1], coord[0]]));
                    bounds.extend(layer.getBounds());
                    break;
                case 'polyline':
                case 'linestring':
                    layer = L.polyline(feature.geometry.coordinates.map(coord => [coord[1], coord[0]]));
                    bounds.extend(layer.getBounds());
                    break;
            }

            if (layer) {
                var popupContent = `ID: ${feature.properties.id}<br>${feature.properties.comment}`;
                layer.bindPopup(popupContent);
                featureGroup.addLayer(layer);
                featureLayers[feature.properties.id] = layer;
            }
        });

        if (!bounds.isValid()) {
            map.setView([0, 0], 2);
        } else {
            map.fitBounds(bounds, { padding: [50, 50] });
        }

        // Event Listeners
        document.querySelectorAll('.shapeData').forEach(function (element) {
            element.addEventListener('click', function () {
                var featureId = this.getAttribute('data-feature-id');
                panToFeature(featureId);
            });
        });

        // Functions
        function showConfirmDialog() {
            const modal = new bootstrap.Modal(document.getElementById('confirmDialog'));
            modal.show();
        }

        function confirmDelete() {
            document.getElementById('deleteForm').submit();
        }

        function handleStatusUpdate() {
            var skipEmailCheckbox = document.getElementById('skipEmail');
            if (skipEmailCheckbox.checked) {
                submitForm(true);
            } else {
                const modal = new bootstrap.Modal(document.getElementById('emailConfirmDialog'));
                modal.show();
            }
        }

        function confirmStatusUpdate(sendEmail) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('emailConfirmDialog'));
            if (modal) {
                modal.hide();
            }
            submitForm(!sendEmail);
        }

        function showNotification(message, isSuccess) {
            const notification = document.getElementById('statusNotification');
            const notificationMessage = document.getElementById('notificationMessage');

            notification.className = 'status-notification ' + 
                (isSuccess ? 'success-notification' : 'info-notification');
            notificationMessage.textContent = message;
            notification.style.display = 'block';

            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }

        function submitForm(skipEmail) {
            const form = document.getElementById('updateStatusForm');
            const formData = new FormData(form);
            formData.set('skipEmail', skipEmail.toString());

            fetch(form.action, {
                method: 'POST',
                body: formData
            }).then(response => {
                if (response.ok) {
                    if (skipEmail) {
                        showNotification('Status oppdatert uten e-postvarsling', false);
                    } else {
                        showNotification('Status oppdatert og e-post sendt', true);
                    }

                    setTimeout(() => {
                        window.location.href = response.url;
                    }, 1000);
                }
            }).catch(error => {
                showNotification('Det oppstod en feil under oppdatering', false);
            });
        }

        function panToFeature(id) {
            const layer = featureLayers[id];
            if (layer) {
                if (layer.getBounds) {
                    map.fitBounds(layer.getBounds());
                } else if (layer.getLatLng) {
                    map.setView(layer.getLatLng(), 16);
                }
                if (layer.getPopup()) {
                    layer.openPopup();
                }
            }
        }
    </script>
</body>
</html>