@model Kartverket_group2.Models.LoginViewModel
@{
    ViewData["Title"] = "Logg inn";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />

</head>

<body>
    <div class="login-main">
    <div class="background-image-basic"></div>
    
        <div class="login-container">
            admin@admin.com
            Admin@1234
            <h2>Logg inn</h2>
            <form asp-controller="Login" asp-action="Login" method="post" id="login-form">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="EmailOrUsername" placeholder="Epost/Brukernavn" required>
                <input asp-for="Password" type="password" placeholder="Passord" required>
                <button type="submit" id="submit-button">Logg inn</button>
            </form>
            <div class="register-link">
                <p>Har du ikke bruker? <a href="Register">Registrer deg her</a></p>
                <p>Glemt passord? <a href ="ForgotPassword">Tilbakestil passord</a></p>
            </div>
        </div>
    </div>

    @if (Context.User.Identity?.IsAuthenticated == true)
    {
        <div style="background-color: lightgreen; padding: 10px; margin: 10px;">
            <p>Autentisert som: @Context.User.Identity.Name</p>
            <p>Roller: @string.Join(", ", Context.User.Claims.Where(c => c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role").Select(c => c.Value))</p>
        </div>
    }
    else
    {
        <div style="background-color: lightpink; padding: 10px; margin: 10px;">
            <p>Ikke autentisert</p>
        </div>
    }
</body>
