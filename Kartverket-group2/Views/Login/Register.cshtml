@model RegisterViewModel
@{
    ViewData["Title"] = "Registrer";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Page</title>
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
</head>
<body>
    <div class="login-main">
    <div class="background-image-basic"></div>
    
        <div class="login-container">
            <h2>Registrer</h2>
            <form asp-action="Register" asp-controller="Login" method="post" id="login-form">
                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="Email" type="email" placeholder="Epost" required>
                <span asp-validation-for="Email" class="text-danger"></span>

                <input asp-for="Username" type="text" placeholder="Brukernavn" required>
                <span asp-validation-for="Username" class="text-danger"></span>

                <input asp-for="Password" type="password" placeholder="Passord" required>
                <span asp-validation-for="Password" class="text-danger"></span>

                <input asp-for="ConfirmPassword" type="password" placeholder="Gjenta passord" required>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                <button type="submit" id="submit-button">Registrer</button>
            </form>
            <div class="login-link">
                <p>Har du allerede bruker? <a asp-action="Login">Logg inn her</a></p>
            </div>
        </div>
        </div>
    
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}