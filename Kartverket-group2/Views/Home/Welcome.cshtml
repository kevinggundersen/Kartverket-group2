@{
    ViewData["Title"] = "Welcome";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hei!</title>
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
</head>

<body>
    <div class="background-image-welcome-overlay"></div>
    <div class="background-image-welcome"></div>
    <div class="welcome-container">
        <div class="description-box">
            <h2>Oppdag og Korriger Kartfeil</h2>
            <p>Bidra til å forbedre kartene våre! Har du oppdaget en feil på kartet? Vårt verktøy lar deg enkelt rapportere feil,
                slik at vi kan sikre at kartene er så nøyaktige som mulig!</p>
        </div>
        <div class="box-container">
            <div class="box">
                <h2>Logg inn</h2>
                <p>Har du allerede bruker?</p>
                <a href="/Login/Login" class="submit-button">Logg inn</a>
            </div>
            <div class="box">
                <h2>Registrer</h2>
                <p>Har du ikke bruker?</p>
                <a href="/Login/Register" class="submit-button">Registrer</a>
            </div>
        </div>
    </div>
</body>
